# ──────────────────────────────────────────────────────────────────────────────
# SuccessCore HR Platform — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED for production) ────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=9a6e4d2fb2d3c94df6461a33b91a78df634f19b222d3b2e7a0f7e4f3a73cdebb


# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=successcore
POSTGRES_PORT=5432
# Or set the full connection URL (overrides individual fields):
# ⚠️  NEVER commit real credentials here. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require



# ── Redis ─────────────────────────────────────────────────────────────────────
# Option A: host/port (self-hosted or Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
# Option B: full connection URL (Upstash, Redis Cloud, etc.)
# REDIS_URL=redis://default:password@host:port

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_API_AUDIENCE=https://api.successcore.com
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_ALGORITHMS=RS256

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── OpenAI (for AI-powered features) ─────────────────────────────────────────
OPENAI_API_KEY=

# ── Courier (for notifications) ──────────────────────────────────────────────
COURIER_AUTH_TOKEN=

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=noreply@successcore.com
